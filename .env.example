# MongoDB connection settings
# For local development with MongoDB running on default port:
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=attendance_db

# For testing with in-memory MongoDB (mongomock), set:
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DATABASE=attendance_test_db

# Server settings
HOST=0.0.0.0
PORT=8000

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
